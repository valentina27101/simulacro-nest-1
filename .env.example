# Copia este archivo como .env y cambia los valores.
# Estas claves son ficticias: no las uses como credenciales reales.

PORT=3000

# Varias API Keys válidas, separadas por comas.
API_KEYS=clave-prueba-1,clave-prueba-2

# Ruta del archivo SQLite donde se guardan las solicitudes.
DB_PATH=solicitudes.sqlite
